<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/screen_bg</item>
        <item name="android:statusBarColor">@color/screen_bg</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="FormLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:textColor">@color/text_muted</item>
        <item name="android:textSize">@dimen/form_label_size</item>
    </style>

    <style name="FormField">
        <item name="android:minHeight">@dimen/form_touch</item>
        <item name="android:background">@drawable/field_bg</item>
        <item name="android:paddingStart">@dimen/form_field_padding</item>
        <item name="android:paddingEnd">@dimen/form_field_padding</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_hint</item>
        <item name="android:textSize">@dimen/form_text_size</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <style name="FormError">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:textColor">@color/error</item>
        <item name="android:textSize">@dimen/form_error_size</item>
        <item name="android:visibility">gone</item>
    </style>

    <style name="DetailSection">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/detail_section_gap</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:textColor">@color/text_muted</item>
        <item name="android:textSize">@dimen/detail_section_text_size</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="DetailBox">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/field_bg</item>
        <item name="android:paddingStart">@dimen/form_field_padding</item>
        <item name="android:paddingEnd">@dimen/form_field_padding</item>
        <item name="android:paddingTop">@dimen/form_field_padding</item>
        <item name="android:paddingBottom">@dimen/form_field_padding</item>
    </style>

    <style name="DetailTextButton" parent="android:Widget.Material.Button.Borderless">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">@dimen/detail_button_height</item>
        <item name="android:minHeight">@dimen/detail_button_height</item>
        <item name="android:textColor">@color/accent</item>
        <item name="android:textSize">@dimen/body_text_size</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
