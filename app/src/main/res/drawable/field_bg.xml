<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/field_bg" />
            <stroke android:width="@dimen/form_stroke_active" android:color="@color/error" />
            <corners android:radius="@dimen/form_field_radius" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/field_bg" />
            <stroke android:width="@dimen/form_stroke_active" android:color="@color/accent" />
            <corners android:radius="@dimen/form_field_radius" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/field_bg" />
            <stroke android:width="@dimen/form_stroke" android:color="@color/field_stroke" />
            <corners android:radius="@dimen/form_field_radius" />
        </shape>
    </item>
</selector>
