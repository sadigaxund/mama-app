<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/title_bar_height"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="@dimen/form_touch"
            android:layout_height="@dimen/form_touch"
            android:layout_marginStart="4dp"
            android:background="@drawable/icon_button_ripple"
            android:contentDescription="@string/detail_back_desc"
            android:src="@drawable/ic_back" />

        <TextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="8dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/title_text_size"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btn_edit"
            android:layout_width="@dimen/form_touch"
            android:layout_height="@dimen/form_touch"
            android:background="@drawable/icon_button_ripple"
            android:contentDescription="@string/detail_edit_desc"
            android:src="@drawable/ic_edit" />

        <ImageButton
            android:id="@+id/btn_delete"
            android:layout_width="@dimen/form_touch"
            android:layout_height="@dimen/form_touch"
            android:layout_marginEnd="4dp"
            android:background="@drawable/icon_button_ripple"
            android:contentDescription="@string/detail_delete_desc"
            android:src="@drawable/ic_delete" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@drawable/tab_divider" />

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/form_bottom_space">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/form_side"
            android:paddingEnd="@dimen/form_side"
            android:paddingTop="@dimen/form_gap">

            <!-- header card -->
            <LinearLayout
                android:id="@+id/header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="@dimen/detail_header_padding"
                android:paddingBottom="@dimen/detail_header_padding"
                android:paddingStart="@dimen/card_padding_start"
                android:paddingEnd="@dimen/detail_header_padding">

                <TextView
                    android:id="@+id/kind_line"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/chip_text_size"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/customer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/detail_name_text_size"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/phone_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/phone"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:singleLine="true"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/form_text_size" />

                    <ImageButton
                        android:id="@+id/btn_call"
                        android:layout_width="@dimen/form_touch"
                        android:layout_height="@dimen/form_touch"
                        android:background="@drawable/icon_button_ripple"
                        android:contentDescription="@string/detail_call_desc"
                        android:src="@drawable/ic_call" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/deadline"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/form_text_size" />

                    <TextView
                        android:id="@+id/overdue_chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/chip_margin_start"
                        android:paddingStart="@dimen/chip_padding_horizontal"
                        android:paddingEnd="@dimen/chip_padding_horizontal"
                        android:paddingTop="@dimen/chip_padding_vertical"
                        android:paddingBottom="@dimen/chip_padding_vertical"
                        android:singleLine="true"
                        android:text="@string/card_overdue"
                        android:textColor="@color/overdue_text"
                        android:textSize="@dimen/chip_text_size"
                        android:visibility="gone" />
                </LinearLayout>

                <TextView
                    android:id="@+id/stage_line"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/text_muted"
                    android:textSize="@dimen/form_text_size" />
            </LinearLayout>

            <!-- photos -->
            <TextView style="@style/DetailSection" android:text="@string/section_photos" />
            <LinearLayout
                style="@style/DetailBox"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/photos_empty"
                    android:textColor="@color/text_muted"
                    android:textSize="@dimen/body_text_size" />
                <Button
                    android:id="@+id/btn_add_photo"
                    style="@style/DetailTextButton"
                    android:text="@string/photos_add" />
            </LinearLayout>

            <!-- visits -->
            <TextView style="@style/DetailSection" android:text="@string/section_visits" />
            <LinearLayout
                style="@style/DetailBox"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/visits_empty"
                    android:textColor="@color/text_muted"
                    android:textSize="@dimen/body_text_size" />
                <Button
                    android:id="@+id/btn_add_visit"
                    style="@style/DetailTextButton"
                    android:text="@string/visits_add" />
            </LinearLayout>

            <!-- money -->
            <TextView style="@style/DetailSection" android:text="@string/section_money" />
            <LinearLayout
                android:id="@+id/ledger"
                style="@style/DetailBox"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="4dp" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <Button
                    android:id="@+id/btn_add_payment"
                    style="@style/DetailTextButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/add_payment" />
                <Button
                    android:id="@+id/btn_add_expense"
                    style="@style/DetailTextButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/add_expense" />
            </LinearLayout>

            <!-- notes -->
            <TextView style="@style/DetailSection" android:text="@string/label_notes" />
            <TextView
                android:id="@+id/notes"
                style="@style/DetailBox"
                android:textColor="@color/text_primary"
                android:textIsSelectable="true"
                android:textSize="@dimen/form_text_size" />

            <!-- moves -->
            <LinearLayout
                android:id="@+id/actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/detail_section_gap"
                android:orientation="vertical" />

            <Button
                android:id="@+id/btn_share"
                style="@style/DetailTextButton"
                android:layout_width="match_parent"
                android:text="@string/share" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
