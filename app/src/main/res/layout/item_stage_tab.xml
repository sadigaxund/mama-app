<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/tab_min_height"
    android:orientation="vertical"
    android:background="?android:attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:minHeight="@dimen/tab_min_height"
        android:orientation="horizontal"
        android:paddingStart="@dimen/tab_padding_horizontal"
        android:paddingEnd="@dimen/tab_padding_horizontal">

        <TextView
            android:id="@+id/tab_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/tab_text_size" />

        <TextView
            android:id="@+id/tab_badge"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/tab_badge_height"
            android:layout_marginStart="@dimen/tab_badge_gap"
            android:background="@drawable/tab_badge_bg"
            android:gravity="center"
            android:includeFontPadding="false"
            android:minWidth="@dimen/tab_badge_height"
            android:paddingStart="@dimen/tab_badge_padding"
            android:paddingEnd="@dimen/tab_badge_padding"
            android:singleLine="true"
            android:textSize="@dimen/tab_badge_text_size"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <View
        android:id="@+id/tab_underline"
        android:layout_width="match_parent"
        android:layout_height="@dimen/tab_underline_height"
        android:background="@color/accent"
        android:visibility="invisible" />
</LinearLayout>
