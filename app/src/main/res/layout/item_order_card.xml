<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/card_margin_side"
    android:paddingEnd="@dimen/card_margin_side"
    android:paddingTop="@dimen/card_margin_vertical"
    android:paddingBottom="@dimen/card_margin_vertical">

    <LinearLayout
        android:id="@+id/card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="@dimen/card_padding"
        android:paddingBottom="@dimen/card_padding"
        android:paddingStart="@dimen/card_padding_start"
        android:paddingEnd="@dimen/card_padding_end">

        <FrameLayout
            android:id="@+id/photo_slot"
            android:layout_width="@dimen/photo_slot_size"
            android:layout_height="@dimen/photo_slot_size">

            <ImageView
                android:id="@+id/photo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/placeholder_letter"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textSize="@dimen/photo_placeholder_text_size"
                android:textStyle="bold" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/text_gap"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/number"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:textColor="@color/text_muted"
                    android:textSize="@dimen/name_text_size" />

                <TextView
                    android:id="@+id/name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/name_text_size"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/line2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="0"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textColor="@color/text_muted"
                    android:textSize="@dimen/body_text_size" />

                <TextView
                    android:id="@+id/overdue_chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/chip_margin_start"
                    android:paddingStart="@dimen/chip_padding_horizontal"
                    android:paddingEnd="@dimen/chip_padding_horizontal"
                    android:paddingTop="@dimen/chip_padding_vertical"
                    android:paddingBottom="@dimen/chip_padding_vertical"
                    android:singleLine="true"
                    android:text="@string/card_overdue"
                    android:textColor="@color/overdue_text"
                    android:textSize="@dimen/chip_text_size"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/balance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:ellipsize="end"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/body_text_size" />

            <TextView
                android:id="@+id/appointment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:ellipsize="end"
                android:textColor="@color/text_muted"
                android:textSize="@dimen/body_text_size"
                android:visibility="gone" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/arrow"
            android:layout_width="@dimen/arrow_target"
            android:layout_height="@dimen/arrow_target"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/move_next_desc"
            android:focusable="false"
            android:src="@drawable/ic_arrow_forward" />
    </LinearLayout>
</FrameLayout>
