<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/title_bar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/title_bar_height"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="@dimen/title_bar_padding_start">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/board_title"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/title_text_size"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btn_menu"
                android:layout_width="@dimen/form_touch"
                android:layout_height="@dimen/form_touch"
                android:layout_marginEnd="4dp"
                android:background="@drawable/icon_button_ripple"
                android:contentDescription="@string/menu_desc"
                android:src="@drawable/ic_more" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/search_height"
            android:layout_marginStart="@dimen/form_side"
            android:layout_marginEnd="@dimen/form_side">

            <EditText
                android:id="@+id/search_field"
                style="@style/FormField"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:hint="@string/search_hint"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:paddingStart="@dimen/search_icon_pad"
                android:paddingEnd="@dimen/search_clear_pad"
                android:singleLine="true" />

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center_vertical|start"
                android:layout_marginStart="@dimen/form_field_padding"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_search" />

            <ImageButton
                android:id="@+id/search_clear"
                android:layout_width="@dimen/arrow_target"
                android:layout_height="@dimen/arrow_target"
                android:layout_gravity="center_vertical|end"
                android:background="@drawable/icon_button_ripple"
                android:contentDescription="@string/search_clear_desc"
                android:src="@drawable/ic_close"
                android:visibility="gone" />
        </FrameLayout>

        <HorizontalScrollView
            android:id="@+id/filter_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:overScrollMode="never"
            android:paddingStart="@dimen/form_gap"
            android:paddingEnd="@dimen/form_gap"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/filter_strip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <HorizontalScrollView
            android:id="@+id/tab_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:overScrollMode="never">

            <LinearLayout
                android:id="@+id/tab_strip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <View
            android:id="@+id/tab_rule"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@drawable/tab_divider" />

        <FrameLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ListView
                android:id="@+id/order_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:divider="@null"
                android:dividerHeight="0dp"
                android:clipToPadding="false"
                android:paddingTop="@dimen/list_padding_top"
                android:paddingBottom="@dimen/list_padding_bottom"
                android:scrollbars="none" />

            <TextView
                android:id="@+id/empty_text"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="@string/board_empty"
                android:textColor="@color/text_muted"
                android:textSize="@dimen/empty_text_size"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/undo_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/undo_bar_height"
        android:layout_gravity="bottom"
        android:layout_margin="@dimen/undo_bar_margin"
        android:background="@drawable/undo_bar_bg"
        android:elevation="@dimen/fab_elevation"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/undo_action_padding"
        android:visibility="gone">

        <TextView
            android:id="@+id/undo_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/undo_bar_text"
            android:textSize="@dimen/undo_bar_text_size" />

        <TextView
            android:id="@+id/visit_action"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="@dimen/undo_action_padding"
            android:paddingEnd="@dimen/undo_action_padding"
            android:singleLine="true"
            android:text="@string/appt_board_action"
            android:textColor="@color/undo_bar_text"
            android:textSize="@dimen/undo_bar_text_size"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/undo_action"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="@dimen/undo_action_padding"
            android:paddingEnd="@dimen/undo_action_padding"
            android:singleLine="true"
            android:text="@string/undo_action"
            android:textColor="@color/undo_bar_text"
            android:textSize="@dimen/undo_bar_text_size"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/fab"
        android:layout_width="@dimen/fab_size"
        android:layout_height="@dimen/fab_size"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/fab_margin"
        android:background="@drawable/fab_bg"
        android:elevation="@dimen/fab_elevation"
        android:gravity="center"
        android:text="+"
        android:textColor="@color/on_accent"
        android:textSize="@dimen/fab_text_size"
        android:contentDescription="@string/add_order_desc"
        android:clickable="true"
        android:focusable="true" />
</FrameLayout>
